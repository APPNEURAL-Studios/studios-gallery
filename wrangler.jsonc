{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Asset-only Worker — no `main`, the static build is served directly.
  "name": "studios-gallery",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./dist",
    // A flat directory site: unknown paths should 404 rather than silently
    // serving the index.
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true },

  "env": {
    "production": {
      "name": "studios-gallery",
      "workers_dev": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      },
      "routes": [{ "pattern": "studios.appneural.com", "custom_domain": true }],
      "observability": { "enabled": true }
    },

    "dev": {
      "name": "studios-gallery-dev",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      },
      "routes": [{ "pattern": "studios-dev.appneural.com", "custom_domain": true }],
      "observability": { "enabled": true }
    }
  }
}
